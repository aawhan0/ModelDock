# Backend authentication is enabled by default.
# Generate a strong random value for the admin key before starting ModelDock.
MODELDOCK_API_AUTH_ENABLED=true
MODELDOCK_ADMIN_API_KEY=replace-with-a-long-random-admin-key
MODELDOCK_FRONTEND_ORIGIN=http://localhost:3000
# Optional comma-separated additional browser origins. Wildcards are rejected.
MODELDOCK_CORS_ORIGINS=http://localhost:3000
MODELDOCK_LOG_LEVEL=INFO

# Uploaded model artifacts are bounded to protect the service from oversized requests.
MODELDOCK_MAX_ARTIFACT_SIZE_BYTES=52428800
# Batch inference is bounded per request. The default is 100 inputs.
MODELDOCK_MAX_BATCH_SIZE=100

# API rate limiting uses Redis. These defaults allow 60 requests per client per minute.
MODELDOCK_RATE_LIMIT_ENABLED=true
MODELDOCK_RATE_LIMIT_REQUESTS=60
MODELDOCK_RATE_LIMIT_WINDOW_SECONDS=60
MODELDOCK_RATE_LIMIT_REDIS_URL=redis://redis:6379/0
MODELDOCK_RATE_LIMIT_FAIL_OPEN=true

# Production monitoring defaults. The monitoring window is 24 hours.
MODELDOCK_MONITORING_WINDOW_HOURS=24
MODELDOCK_MONITORING_P95_LATENCY_MS=1000
MODELDOCK_MONITORING_ERROR_RATE_THRESHOLD=0.05
MODELDOCK_MONITORING_DRIFT_MODERATE_THRESHOLD=0.1
MODELDOCK_MONITORING_DRIFT_SIGNIFICANT_THRESHOLD=0.2

NEXT_PUBLIC_API_URL=http://localhost:8000

# WARNING: NEXT_PUBLIC_* values are exposed to browser JavaScript.
# Never put MODELDOCK_ADMIN_API_KEY in a NEXT_PUBLIC_* variable.
# A browser-facing API key should be treated as public and dedicated to the UI.
NEXT_PUBLIC_MODELDOCK_API_KEY=
